#!/usr/bin/env bash
# End-to-end test: boot an ephemeral ci-server from this worktree and run real
# jobs through it (dispatch → ci-run.sh → worktree → status). Runnable locally
# (./ci/e2e) or via `sci push simple-ci/e2e`. Self-contained: builds a throwaway
# git repo and points all CI_* paths at a tempdir.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"

# ci-server.tcl sources wapp/; a fresh CI worktree won't have the submodule.
[[ -f "$REPO/wapp/wapp.tcl" ]] || git -C "$REPO" submodule update --init --depth 1 wapp

WORK=$(mktemp -d)
SRV=""
cleanup() { [[ -n "$SRV" ]] && kill "$SRV" 2>/dev/null || true; rm -rf "$WORK"; }
trap cleanup EXIT

export CI_LOGS="$WORK/logs" CI_WORKSPACE="$WORK/ws" CI_WORKTREES="$WORK/wt"
mkdir -p "$CI_WORKSPACE" "$CI_WORKTREES"

git init -q --bare "$WORK/origin.git"
git clone -q "$WORK/origin.git" "$CI_WORKSPACE/demo" 2>/dev/null
(
    cd "$CI_WORKSPACE/demo"
    git config user.email t@t; git config user.name t
    mkdir ci
    printf '#!/usr/bin/env bash\necho ok\n'            > ci/ok
    printf '#!/usr/bin/env bash\necho boom >&2\nexit 3\n' > ci/bad
    chmod +x ci/ok ci/bad
    git add -A; git commit -qm init; git push -q origin HEAD:master
)
git -C "$CI_WORKSPACE/demo" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/master
COMMIT=$(git -C "$CI_WORKSPACE/demo" rev-parse HEAD)

PORT=$(( 18090 + ${CI_SLOT_INDEX:-0} ))
while ss -tln "sport = :$PORT" 2>/dev/null | grep -q ":$PORT"; do PORT=$(( PORT + 1 )); done
URL="http://127.0.0.1:$PORT"

tclsh "$REPO/ci-server.tcl" -server "127.0.0.1:$PORT" >"$WORK/server.log" 2>&1 &
SRV=$!
for _ in $(seq 1 40); do curl -sf "$URL/health" >/dev/null 2>&1 && break; sleep 0.25; done
curl -sf "$URL/health" >/dev/null || { echo "server failed to start:"; cat "$WORK/server.log"; exit 1; }

PASS=0; FAIL=0
ok()  { printf 'pass: %s\n' "$1"; PASS=$(( PASS + 1 )); }
no()  { printf 'FAIL: %s\n  %s\n' "$1" "${2:-}"; FAIL=$(( FAIL + 1 )); }

# Submit a job and block until terminal; echoes "status exit id".
run_job() {
    local r id st
    r=$(curl -s -X POST "$URL/job" -H 'Content-Type: application/json' \
        -d "{\"repo\":\"$1\",\"commit\":\"$2\",\"script\":\"$3\"}")
    id=$(printf '%s' "$r" | jq -r .id)
    for _ in $(seq 1 80); do
        st=$(curl -s "$URL/job/$id" | jq -r .status)
        [[ "$st" == pass || "$st" == fail ]] && break
        sleep 0.25
    done
    printf '%s %s %s' "$st" "$(curl -s "$URL/job/$id" | jq -r '.exit // "?"')" "$id"
}

if CI_SERVER_URL="$URL" "$REPO/ci/smoke" >/dev/null 2>&1; then ok "api smoke suite"; else no "api smoke suite"; fi

code=$(curl -s -o /dev/null -w '%{http_code}' -X OPTIONS "$URL/jobs")
if [[ "$code" == 200 ]]; then ok "OPTIONS preflight → 200"; else no "OPTIONS preflight" "got $code"; fi
if curl -s "$URL/nope" | grep -q '"error"'; then ok "JSON 404 hook"; else no "JSON 404 hook"; fi

read -r st ex id <<<"$(run_job demo "$COMMIT" ok)"
if [[ "$st" == pass && "$ex" == 0 ]]; then ok "pass job lifecycle"; else no "pass job" "status=$st exit=$ex"; fi
if curl -s "$URL/log/$id" | grep -q '^ok$'; then ok "pass job log captured"; else no "pass job log"; fi

read -r st ex id <<<"$(run_job demo "$COMMIT" bad)"
if [[ "$st" == fail && "$ex" == 3 ]]; then ok "fail job lifecycle (exit propagated)"; else no "fail job" "status=$st exit=$ex"; fi

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
(( FAIL == 0 ))
